validate_update_source_installation() {
    source_root=$1
    source_version=$2
    source_command=$source_root/.intelli-repo/bin/intelli-repo
    source_modules=$source_root/.gitmodules
    [ -x "$source_command" ] || return 1
    [ "$("$source_command" version 2>/dev/null || true)" = "$source_version" ] || return 1
    case "$source_version" in
        v0.1.0-beta.1)
            expected_source_base=$readonly_supported_beta_1_base_agent_commit
            expected_source_operator=$readonly_supported_beta_1_operator_agent_commit
            expected_source_wiki=$readonly_supported_beta_1_wiki_agent_commit
            ;;
        "$readonly_distribution_version")
            expected_source_base=$readonly_base_agent_commit
            expected_source_operator=$readonly_operator_agent_commit
            expected_source_wiki=$readonly_wiki_agent_commit
            ;;
        *) expected_source_base=''; expected_source_operator=''; expected_source_wiki='' ;;
    esac
    for component in base-agent operator-agent wiki-agent; do
        case "$component" in
            base-agent) source_variable=readonly_base_agent_commit; expected_source_commit=$expected_source_base ;;
            operator-agent) source_variable=readonly_operator_agent_commit; expected_source_commit=$expected_source_operator ;;
            wiki-agent) source_variable=readonly_wiki_agent_commit; expected_source_commit=$expected_source_wiki ;;
        esac
        source_commit=$(awk -F"'" -v variable="$source_variable" '$1 == variable "=" { print $2; exit }' "$source_command")
        case "$source_commit" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) return 1 ;; esac
        component_path=.intelli-repo/$component
        [ -z "$expected_source_commit" ] || [ "$source_commit" = "$expected_source_commit" ] || return 1
        [ "$(index_commit "$source_root" "$component_path" 2>/dev/null || true)" = "$source_commit" ] || return 1
        [ "$(git -C "$source_root/$component_path" rev-parse HEAD 2>/dev/null || true)" = "$source_commit" ] || return 1
        [ -z "$(git -C "$source_root/$component_path" status --porcelain 2>/dev/null)" ] || return 1
        module_key=$(submodule_entry_for_path "$source_modules" "$component_path") || return 1
        [ -n "$(git config -f "$source_modules" --get "$module_key.url" 2>/dev/null || true)" ] || return 1
        [ -z "$(git config -f "$source_modules" --get "$module_key.branch" 2>/dev/null || true)" ] || return 1
    done
    [ "$(grep -Fc '# BEGIN INTELLI-REPO MANAGED v1' "$source_root/Makefile" 2>/dev/null || true)" -eq 1 ] || return 1
    [ "$(grep -Fc '# END INTELLI-REPO MANAGED v1' "$source_root/Makefile" 2>/dev/null || true)" -eq 1 ] || return 1
}

prepare_update_scaffold() {
    scaffold_repository=$1
    scaffold_payload=$2
    : >"$scaffold_payload/wiki-scaffold.before"
    : >"$scaffold_payload/created-wiki-directories"
    : >"$scaffold_payload/created-wiki-markers"
    : >"$scaffold_payload/planned-wiki-directories"
    : >"$scaffold_payload/planned-wiki-markers"
    required_wiki_directories | while IFS= read -r relative_path; do
        target_path=$scaffold_repository/$relative_path
        marker_path=$target_path/.gitkeep
        [ ! -L "$target_path" ] || fail "symlinked required wiki path is prohibited: $relative_path" "$readonly_exit_preflight"
        [ ! -e "$target_path" ] || [ -d "$target_path" ] || fail "required wiki path is not a directory: $relative_path" "$readonly_exit_preflight"
        [ ! -L "$marker_path" ] || fail "symlinked wiki marker is prohibited: $relative_path/.gitkeep" "$readonly_exit_preflight"
        [ ! -e "$marker_path" ] || [ -f "$marker_path" ] || fail "wiki marker path is not a regular file: $relative_path/.gitkeep" "$readonly_exit_preflight"
        if [ -d "$target_path" ]; then before_directory=present; else before_directory=absent; fi
        if [ -f "$marker_path" ]; then before_marker=present; else before_marker=absent; fi
        printf '%s|%s|%s\n' "$relative_path" "$before_directory" "$before_marker" >>"$scaffold_payload/wiki-scaffold.before"
        [ "$before_directory" = present ] || printf '%s\n' "$relative_path" >>"$scaffold_payload/planned-wiki-directories"
        if [ "$before_marker" = absent ] && { [ "$before_directory" = absent ] || [ -z "$(find "$target_path" -mindepth 1 -maxdepth 1 -print -quit)" ]; }; then
            printf '%s/.gitkeep\n' "$relative_path" >>"$scaffold_payload/planned-wiki-markers"
        fi
    done
}

backfill_update_scaffold() {
    scaffold_repository=$1
    scaffold_payload=$2
    while IFS='|' read -r relative_path before_directory before_marker; do
        target_path=$scaffold_repository/$relative_path
        marker_path=$target_path/.gitkeep
        if [ "$before_directory" = absent ]; then
            mkdir -p "$target_path" || return 1
            printf '%s\n' "$relative_path" >>"$scaffold_payload/created-wiki-directories"
        fi
        if [ "$before_marker" = absent ] && [ -z "$(find "$target_path" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
            : >"$marker_path" || return 1
            printf '%s/.gitkeep\n' "$relative_path" >>"$scaffold_payload/created-wiki-markers"
        fi
    done <"$scaffold_payload/wiki-scaffold.before"
}

remove_created_update_scaffold() {
    scaffold_repository=$1
    scaffold_payload=$2
    scaffold_report=$3
    [ -f "$scaffold_payload/created-wiki-markers" ] || return 0
    while IFS= read -r marker_relative || [ -n "$marker_relative" ]; do
        [ -n "$marker_relative" ] || continue
        marker_path=$scaffold_repository/$marker_relative
        if [ -f "$marker_path" ] && [ ! -L "$marker_path" ] && [ ! -s "$marker_path" ]; then
            rm -f -- "$marker_path"
        elif [ -e "$marker_path" ]; then
            printf 'preserved user-owned marker: %s\n' "$marker_relative" >>"$scaffold_report"
        fi
    done <"$scaffold_payload/created-wiki-markers"
    if [ -f "$scaffold_payload/created-wiki-directories" ]; then
        sort -r "$scaffold_payload/created-wiki-directories" | while IFS= read -r directory_relative || [ -n "$directory_relative" ]; do
            [ -n "$directory_relative" ] || continue
            directory_path=$scaffold_repository/$directory_relative
            if [ -d "$directory_path" ] && [ ! -L "$directory_path" ]; then
                rmdir "$directory_path" 2>/dev/null || printf 'preserved user-owned directory: %s\n' "$directory_relative" >>"$scaffold_report"
            fi
        done
    fi
}

