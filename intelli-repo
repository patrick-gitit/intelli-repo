#!/bin/sh
set -eu

readonly_distribution_version='v0.1.0-beta.2.4'
readonly_base_agent_commit='a6d697c28238f2c2b3f5bbf3ce24f39e39c4ccaf'
readonly_operator_agent_commit='49175ac1f1a7bf1e57c74d2d34c9567c916102d5'
readonly_wiki_agent_commit='a6d2ebfb6cfb78076ad6d06dc87f1aed7ce57ab9'
readonly_supported_beta_1_base_agent_commit='9b3eec9f0566da3ace5ab0cb47d4c5a2dc1d9b0a'
readonly_supported_beta_1_operator_agent_commit='e8aec0e5f88af5624aa12f37656c9ef7243f70ca'
readonly_supported_beta_1_wiki_agent_commit='3543fdb11791fd2298c62bb41301bec628768501'
readonly_base_agent_url='https://github.com/patrick-gitit/irp_base-agent.git'
readonly_operator_agent_url='https://github.com/patrick-gitit/irp_operator-agent.git'
readonly_wiki_agent_url='https://github.com/patrick-gitit/irp_wiki-agent.git'
readonly_public_base='https://raw.githubusercontent.com/patrick-gitit/intelli-repo'
base_agent_url=$readonly_base_agent_url
operator_agent_url=$readonly_operator_agent_url
wiki_agent_url=$readonly_wiki_agent_url
readonly_exit_usage=64
readonly_exit_preflight=65
readonly_exit_approval=66
readonly_exit_compatibility=67
readonly_exit_mutation=68
readonly_exit_validation=69
readonly_exit_rollback=70
readonly_lifecycle_protocol=1

usage() {
    cat <<'USAGE'
Usage: intelli-repo COMMAND [OPTIONS]

Lifecycle commands:
  install      Install exact-pinned Intelli-Repo components
  configure    Explain defaults or update optional configuration
  update       Update to an exact version or roll back a named update
  doctor       Inspect repository and installation health
  uninstall    Remove owned integration; preserve user data by default

Capability status:
  lint         Unavailable; no installed command dispatcher
  audit        Unavailable; no installed command dispatcher
  ingest       Unavailable; no installed command dispatcher
  task         Unavailable; no installed command dispatcher
  release      Unavailable; no installed command dispatcher

Global commands:
  version      Print the exact command version
  help         Show this help

Common options are --repo PATH, --dry-run, and --yes. Install accepts --version
VERSION. Update requires either --version VERSION or --rollback OPERATION_ID.
Configure accepts repeatable --set-agent NAME=enabled|disabled plus explicit
--set-secret-provider none|dotenv and --set-secret-name NAME. Uninstall accepts
--purge-user-data only through its separate confirmation contract.
USAGE
}

fail() {
    printf 'intelli-repo: %s\n' "$1" >&2
    exit "${2:-$readonly_exit_usage}"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1" "$readonly_exit_preflight"
}

digest_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{ print $1 }'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{ print $1 }'
    else
        fail 'sha256sum or shasum is required' "$readonly_exit_preflight"
    fi
}

semver_valid() {
    printf '%s\n' "$1" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z][0-9A-Za-z.-]*)?$'
}

commit_valid() {
    printf '%s\n' "$1" | grep -Eq '^[0-9a-f]{40}$'
}

digest_valid() {
    printf '%s\n' "$1" | grep -Eq '^[0-9a-f]{64}$'
}

version_at_least() {
    actual=$1
    required=$2
    awk -v actual="$actual" -v required="$required" 'BEGIN {
        split(actual, a, "."); split(required, r, ".");
        for (i = 1; i <= 3; i++) {
            a[i] += 0; r[i] += 0
            if (a[i] > r[i]) exit 0
            if (a[i] < r[i]) exit 1
        }
        exit 0
    }'
}

yaml_scalar() {
    yaml_key=$1
    yaml_file=$2
    yaml_lines=$(grep -Ec "^$yaml_key: \"[^\"]*\"$" "$yaml_file" || true)
    [ "$yaml_lines" -eq 1 ] || return 1
    sed -n "s/^$yaml_key: \"\([^\"]*\)\"$/\1/p" "$yaml_file"
}

yaml_component() {
    yaml_key=$1
    yaml_file=$2
    yaml_lines=$(grep -Ec "^  $yaml_key: \"[0-9a-f]{40}\"$" "$yaml_file" || true)
    [ "$yaml_lines" -eq 1 ] || return 1
    sed -n "s/^  $yaml_key: \"\([0-9a-f]\{40\}\)\"$/\1/p" "$yaml_file"
}

configuration_value() {
    configuration_file=$1
    configuration_key=$2
    configuration_default=$3
    if [ ! -f "$configuration_file" ]; then
        printf '%s\n' "$configuration_default"
        return
    fi
    if configuration_result=$(yaml_scalar "$configuration_key" "$configuration_file" 2>/dev/null); then
        printf '%s\n' "$configuration_result"
    else
        printf '%s\n' "$configuration_default"
    fi
}

validate_configuration() {
    configuration_file=$1
    [ -e "$configuration_file" ] || return 0
    [ -f "$configuration_file" ] && [ ! -L "$configuration_file" ] || return 1
    meaningful_lines=$(grep -Evc '^[[:space:]]*(#.*)?$' "$configuration_file" || true)
    case "$meaningful_lines" in 4|6) ;; *) return 1 ;; esac
    [ "$(yaml_scalar schema_version "$configuration_file" 2>/dev/null || true)" = 1 ] || return 1
    for configuration_key in base_agent operator_agent wiki_agent; do
        configuration_setting=$(yaml_scalar "$configuration_key" "$configuration_file" 2>/dev/null || true)
        case "$configuration_setting" in enabled|disabled) ;; *) return 1 ;; esac
    done
    if [ "$meaningful_lines" -eq 6 ]; then
        secret_provider=$(yaml_scalar secret_provider "$configuration_file" 2>/dev/null || true)
        secret_name=$(yaml_scalar secret_name "$configuration_file" 2>/dev/null || true)
        case "$secret_provider" in
            none) [ -z "$secret_name" ] || return 1 ;;
            dotenv) printf '%s\n' "$secret_name" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]{0,127}$' || return 1 ;;
            *) return 1 ;;
        esac
    fi
}

render_configuration() {
    output_file=$1
    base_setting=$2
    operator_setting=$3
    wiki_setting=$4
    secret_provider_setting=${5:-none}
    secret_name_setting=${6:-}
    cat >"$output_file" <<EOF
schema_version: "1"
base_agent: "$base_setting"
operator_agent: "$operator_setting"
wiki_agent: "$wiki_setting"
secret_provider: "$secret_provider_setting"
secret_name: "$secret_name_setting"
EOF
}

resolve_installed_repository() {
    requested_repository=$1
    canonical_request=$(canonical_requested_path "$requested_repository") || fail 'target path cannot be resolved' "$readonly_exit_preflight"
    case "$canonical_request" in /) fail 'filesystem root cannot be a lifecycle target' "$readonly_exit_preflight" ;; esac
    repository_root=$(find_repository_root "$canonical_request") || fail 'target is not a Git worktree' "$readonly_exit_preflight"
    repository_root=$(CDPATH= cd -- "$repository_root" && pwd -P)
    for boundary_path in .intelli-repo .intelli-repo/bin .intelli-repo/operations .intelli-repo/base-agent .intelli-repo/operator-agent .intelli-repo/wiki-agent .gitmodules Makefile repo-agent-config.yaml; do
        [ ! -L "$repository_root/$boundary_path" ] || fail "symlinked managed boundary is prohibited: $boundary_path" "$readonly_exit_preflight"
    done
    [ -x "$repository_root/.intelli-repo/bin/intelli-repo" ] || fail 'Intelli-Repo is not installed in the target worktree' "$readonly_exit_compatibility"
}

approve_proposal() {
    approval_granted=$1
    approval_prompt=$2
    if [ "$approval_granted" -eq 1 ]; then
        return
    fi
    [ -r /dev/tty ] && [ -w /dev/tty ] || fail 'approval requires /dev/tty or explicit --yes' "$readonly_exit_approval"
    if ! ( : </dev/tty >/dev/tty ) 2>/dev/null; then
        fail 'approval requires a controlling terminal or explicit --yes' "$readonly_exit_approval"
    fi
    printf '%s' "$approval_prompt" >/dev/tty
    IFS= read -r approval_response </dev/tty || fail 'approval could not be read' "$readonly_exit_approval"
    [ "$approval_response" = yes ] || fail 'operation was not approved' "$readonly_exit_approval"
}

approve_destructive_purge() {
    destructive_confirmation=$1
    if [ "$destructive_confirmation" = DELETE-USER-DATA ]; then
        return
    fi
    [ -r /dev/tty ] && [ -w /dev/tty ] || fail 'purge requires --confirm-purge DELETE-USER-DATA or a controlling terminal' "$readonly_exit_approval"
    if ! ( : </dev/tty >/dev/tty ) 2>/dev/null; then
        fail 'purge requires --confirm-purge DELETE-USER-DATA or a controlling terminal' "$readonly_exit_approval"
    fi
    printf '%s' 'Permanently delete the listed user data? Type DELETE-USER-DATA: ' >/dev/tty
    IFS= read -r destructive_response </dev/tty || fail 'destructive approval could not be read' "$readonly_exit_approval"
    [ "$destructive_response" = DELETE-USER-DATA ] || fail 'purge was not explicitly confirmed' "$readonly_exit_approval"
}

find_repository_root() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null || return 1
}

dotenv_refuse() {
    fail "dotenv refused: $1" "$readonly_exit_validation"
}

credential_refuse() {
    fail "credential consumer refused: $1" "$readonly_exit_validation"
}

credential_consume_command() {
    repository_path=.
    credential_provider=''
    requested_name=''
    consumer_profile=''
    operation_identity=''
    authorization_profile=''
    validation_profile=''
    output_fd=''
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo) [ "$#" -ge 2 ] || fail '--repo requires a path'; repository_path=$2; shift 2 ;;
            --provider) [ "$#" -ge 2 ] || fail '--provider requires a value'; credential_provider=$2; shift 2 ;;
            --name) [ "$#" -ge 2 ] || fail '--name requires a value'; requested_name=$2; shift 2 ;;
            --consumer) [ "$#" -ge 2 ] || fail '--consumer requires a value'; consumer_profile=$2; shift 2 ;;
            --operation) [ "$#" -ge 2 ] || fail '--operation requires a value'; operation_identity=$2; shift 2 ;;
            --authorization) [ "$#" -ge 2 ] || fail '--authorization requires a value'; authorization_profile=$2; shift 2 ;;
            --validation) [ "$#" -ge 2 ] || fail '--validation requires a value'; validation_profile=$2; shift 2 ;;
            --output-fd) [ "$#" -ge 2 ] || fail '--output-fd requires a value'; output_fd=$2; shift 2 ;;
            *) fail "unknown internal credential-consumer argument: $1" ;;
        esac
    done
    [ "${INTELLI_REPO_INTERNAL_CREDENTIAL_CONSUMER:-}" = 1 ] || credential_refuse consumer-invalid
    [ "$credential_provider" = dotenv ] || credential_refuse provider-invalid
    printf '%s\n' "$requested_name" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]{0,127}$' || credential_refuse name-missing
    [ "$consumer_profile" = descriptor-v1 ] || credential_refuse consumer-invalid
    printf '%s\n' "$operation_identity" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$' || credential_refuse consumer-invalid
    [ "$authorization_profile" = read-only ] || credential_refuse authorization-invalid
    [ "$validation_profile" = none ] || credential_refuse validation-failed
    [ "$output_fd" = 3 ] || credential_refuse consumer-invalid
    if ! (: >&3) 2>/dev/null; then credential_refuse consumer-invalid; fi

    # The selected name is resolved only from the fixed provider file. The
    # in-process descriptor consumer never consults or mutates an ambient copy.
    INTELLI_REPO_INTERNAL_DOTENV_READER=1
    export INTELLI_REPO_INTERNAL_DOTENV_READER
    dotenv_read_command --repo "$repository_path" --name "$requested_name" --output-fd 3
    unset INTELLI_REPO_INTERNAL_DOTENV_READER
}

dotenv_windows_read() {
    windows_dotenv_path=$1
    windows_requested_name=$2
    if command -v pwsh >/dev/null 2>&1; then
        windows_powershell=$(command -v pwsh)
    elif command -v powershell.exe >/dev/null 2>&1; then
        windows_powershell=$(command -v powershell.exe)
    else
        dotenv_refuse security-unverifiable
    fi
    command -v cygpath >/dev/null 2>&1 || dotenv_refuse security-unverifiable
    windows_dotenv_path=$(cygpath -aw -- "$windows_dotenv_path" 2>/dev/null) || dotenv_refuse path-unsafe

    if INTELLI_REPO_DOTENV_PATH=$windows_dotenv_path INTELLI_REPO_DOTENV_NAME=$windows_requested_name \
        "$windows_powershell" -NoLogo -NoProfile -NonInteractive -Command - \
        >&3 2>/dev/null <<'DOTENV_POWERSHELL'
$ErrorActionPreference = 'Stop'

function Stop-Dotenv([int] $Code) {
    exit $Code
}

try {
    $null = Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
using Microsoft.Win32.SafeHandles;

public static class IntelliRepoDotenvNative {
    [StructLayout(LayoutKind.Sequential)]
    public struct FILE_ATTRIBUTE_TAG_INFO {
        public uint FileAttributes;
        public uint ReparseTag;
    }

    [StructLayout(LayoutKind.Sequential)]
    public struct BY_HANDLE_FILE_INFORMATION {
        public uint FileAttributes;
        public System.Runtime.InteropServices.ComTypes.FILETIME CreationTime;
        public System.Runtime.InteropServices.ComTypes.FILETIME LastAccessTime;
        public System.Runtime.InteropServices.ComTypes.FILETIME LastWriteTime;
        public uint VolumeSerialNumber;
        public uint FileSizeHigh;
        public uint FileSizeLow;
        public uint NumberOfLinks;
        public uint FileIndexHigh;
        public uint FileIndexLow;
    }

    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    public static extern SafeFileHandle CreateFileW(
        string fileName,
        uint desiredAccess,
        uint shareMode,
        IntPtr securityAttributes,
        uint creationDisposition,
        uint flagsAndAttributes,
        IntPtr templateFile);

    [DllImport("kernel32.dll", SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    public static extern bool GetFileInformationByHandleEx(
        SafeFileHandle file,
        int informationClass,
        out FILE_ATTRIBUTE_TAG_INFO information,
        uint bufferSize);

    [DllImport("kernel32.dll", SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    public static extern bool GetFileInformationByHandle(
        SafeFileHandle file,
        out BY_HANDLE_FILE_INFORMATION information);
}
'@
} catch {
    Stop-Dotenv 44
}

$path = [Environment]::GetEnvironmentVariable('INTELLI_REPO_DOTENV_PATH', 'Process')
$requestedName = [Environment]::GetEnvironmentVariable('INTELLI_REPO_DOTENV_NAME', 'Process')
if ([String]::IsNullOrEmpty($path) -or [String]::IsNullOrEmpty($requestedName)) {
    Stop-Dotenv 52
}

$handle = $null
$stream = $null
try {
    $genericRead = [uint32] 0x80000000
    $shareRead = [uint32] 1
    $openExisting = [uint32] 3
    $openReparsePoint = [uint32] 0x00200000
    $sequentialScan = [uint32] 0x08000000
    $handle = [IntelliRepoDotenvNative]::CreateFileW(
        $path,
        $genericRead,
        $shareRead,
        [IntPtr]::Zero,
        $openExisting,
        ($openReparsePoint -bor $sequentialScan),
        [IntPtr]::Zero)
    if ($null -eq $handle -or $handle.IsInvalid) {
        Stop-Dotenv 44
    }

    $attributeInfo = New-Object IntelliRepoDotenvNative+FILE_ATTRIBUTE_TAG_INFO
    $attributeSize = [Runtime.InteropServices.Marshal]::SizeOf($attributeInfo)
    if (-not [IntelliRepoDotenvNative]::GetFileInformationByHandleEx($handle, 9, [ref] $attributeInfo, $attributeSize)) {
        Stop-Dotenv 44
    }
    $directoryAttribute = [uint32] 0x10
    $deviceAttribute = [uint32] 0x40
    $reparseAttribute = [uint32] 0x400
    if (($attributeInfo.FileAttributes -band $reparseAttribute) -ne 0) {
        Stop-Dotenv 40
    }
    if (($attributeInfo.FileAttributes -band ($directoryAttribute -bor $deviceAttribute)) -ne 0) {
        Stop-Dotenv 41
    }

    $fileInfo = New-Object IntelliRepoDotenvNative+BY_HANDLE_FILE_INFORMATION
    if (-not [IntelliRepoDotenvNative]::GetFileInformationByHandle($handle, [ref] $fileInfo)) {
        Stop-Dotenv 44
    }
    if ($fileInfo.NumberOfLinks -ne 1) {
        Stop-Dotenv 40
    }
    $fileLength = ([uint64] $fileInfo.FileSizeHigh * [uint64] 4294967296) + [uint64] $fileInfo.FileSizeLow
    if ($fileLength -gt 65536) {
        Stop-Dotenv 45
    }

    $stream = New-Object -TypeName System.IO.FileStream -ArgumentList @($handle, [System.IO.FileAccess]::Read, 4096, $false)
    $handle = $null
    try {
        if ($stream.PSObject.Methods.Name -contains 'GetAccessControl') {
            $security = $stream.GetAccessControl()
        } else {
            $security = [System.IO.FileSystemAclExtensions]::GetAccessControl($stream)
        }
    } catch {
        Stop-Dotenv 44
    }

    try {
        $currentSid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User
        $ownerSid = $security.GetOwner([System.Security.Principal.SecurityIdentifier])
    } catch {
        Stop-Dotenv 44
    }
    if ($null -eq $currentSid -or $null -eq $ownerSid -or $ownerSid.Value -ne $currentSid.Value) {
        Stop-Dotenv 42
    }
    if (-not $security.AreAccessRulesCanonical) {
        Stop-Dotenv 43
    }
    try {
        $sddl = $security.GetSecurityDescriptorSddlForm([System.Security.AccessControl.AccessControlSections]::Access)
        $rules = $security.GetAccessRules($true, $true, [System.Security.Principal.SecurityIdentifier])
    } catch {
        Stop-Dotenv 44
    }
    if ([String]::IsNullOrEmpty($sddl) -or -not $sddl.Contains('D:')) {
        Stop-Dotenv 43
    }

    $allowedSids = @($currentSid.Value, 'S-1-5-18', 'S-1-5-32-544')
    $currentUserCanRead = $false
    foreach ($rule in $rules) {
        $sid = $rule.IdentityReference
        try {
            $null = $sid.Translate([System.Security.Principal.NTAccount])
        } catch {
            Stop-Dotenv 43
        }
        if ($rule.AccessControlType -eq [System.Security.AccessControl.AccessControlType]::Allow) {
            if ($allowedSids -notcontains $sid.Value) {
                Stop-Dotenv 43
            }
            if ($sid.Value -eq $currentSid.Value -and (($rule.FileSystemRights -band [System.Security.AccessControl.FileSystemRights]::ReadData) -ne 0)) {
                $currentUserCanRead = $true
            }
        } elseif ($rule.AccessControlType -ne [System.Security.AccessControl.AccessControlType]::Deny) {
            Stop-Dotenv 43
        }
        if ($rule.AccessControlType -eq [System.Security.AccessControl.AccessControlType]::Deny -and
            $sid.Value -eq $currentSid.Value -and
            (($rule.FileSystemRights -band [System.Security.AccessControl.FileSystemRights]::ReadData) -ne 0)) {
            Stop-Dotenv 43
        }
    }
    if (-not $currentUserCanRead) {
        Stop-Dotenv 43
    }

    $bytes = New-Object byte[] ([int] $fileLength)
    $offset = 0
    while ($offset -lt $bytes.Length) {
        $count = $stream.Read($bytes, $offset, $bytes.Length - $offset)
        if ($count -eq 0) {
            Stop-Dotenv 52
        }
        $offset += $count
    }
    if ($stream.ReadByte() -ne -1) {
        Stop-Dotenv 45
    }
    $stream.Dispose()
    $stream = $null

    if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
        Stop-Dotenv 47
    }
    try {
        $utf8 = New-Object -TypeName System.Text.UTF8Encoding -ArgumentList @($false, $true)
        $content = $utf8.GetString($bytes)
    } catch {
        Stop-Dotenv 46
    }
    if ($content.IndexOf([char] 0) -ge 0) {
        Stop-Dotenv 47
    }

    $seen = New-Object -TypeName 'System.Collections.Generic.HashSet[string]' -ArgumentList @([System.StringComparer]::Ordinal)
    $selected = $null
    $found = $false
    foreach ($rawLine in $content.Split([char] 10)) {
        $line = $rawLine
        if ($line.EndsWith("`r")) {
            $line = $line.Substring(0, $line.Length - 1)
        }
        if ($line.IndexOf("`r") -ge 0 -or $utf8.GetByteCount($line) -gt 16384) {
            Stop-Dotenv 47
        }
        if ($line -match '^[ \t]*$' -or $line -match '^[ \t]*#') {
            continue
        }
        if ($line -notmatch '^[A-Za-z_][A-Za-z0-9_]*=') {
            Stop-Dotenv 47
        }
        $separator = $line.IndexOf('=')
        $name = $line.Substring(0, $separator)
        if ($name.Length -gt 128) {
            Stop-Dotenv 47
        }
        if (-not $seen.Add($name)) {
            Stop-Dotenv 48
        }
        $value = $line.Substring($separator + 1)
        if ($value.Contains('${') -or $value.Contains('$(') -or $value.Contains('`')) {
            Stop-Dotenv 47
        }
        if ($name -ceq $requestedName) {
            $selected = $value
            $found = $true
        }
    }
    if (-not $found) {
        Stop-Dotenv 49
    }
    if ($selected.Length -eq 0) {
        Stop-Dotenv 50
    }
    $selectedBytes = $utf8.GetBytes($selected)
    if ($selectedBytes.Length -gt 8192) {
        Stop-Dotenv 51
    }
    $output = [Console]::OpenStandardOutput()
    $output.Write($selectedBytes, 0, $selectedBytes.Length)
    $output.Flush()
    exit 0
} catch {
    Stop-Dotenv 52
} finally {
    if ($null -ne $stream) {
        $stream.Dispose()
    } elseif ($null -ne $handle) {
        $handle.Dispose()
    }
}
DOTENV_POWERSHELL
    then
        return 0
    else
        windows_status=$?
    fi

    case "$windows_status" in
        40) dotenv_refuse path-unsafe ;;
        41) dotenv_refuse file-type-unsafe ;;
        42) dotenv_refuse owner-invalid ;;
        43) dotenv_refuse acl-invalid ;;
        44) dotenv_refuse security-unverifiable ;;
        45) dotenv_refuse file-too-large ;;
        46) dotenv_refuse encoding-invalid ;;
        47) dotenv_refuse grammar-invalid ;;
        48) dotenv_refuse duplicate-name ;;
        49) dotenv_refuse name-missing ;;
        50) dotenv_refuse empty-value ;;
        51) dotenv_refuse value-too-large ;;
        *) dotenv_refuse internal-failure ;;
    esac
}

dotenv_read_command() {
    repository_path=.
    requested_name=''
    output_fd=''
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo) [ "$#" -ge 2 ] || fail '--repo requires a path'; repository_path=$2; shift 2 ;;
            --name) [ "$#" -ge 2 ] || fail '--name requires a value'; requested_name=$2; shift 2 ;;
            --output-fd) [ "$#" -ge 2 ] || fail '--output-fd requires a value'; output_fd=$2; shift 2 ;;
            *) fail "unknown internal dotenv-reader argument: $1" ;;
        esac
    done
    [ "${INTELLI_REPO_INTERNAL_DOTENV_READER:-}" = 1 ] || fail 'internal dotenv reader is not a public command'
    [ "$output_fd" = 3 ] || fail 'internal dotenv reader requires dedicated descriptor 3'
    if ! (: >&3) 2>/dev/null; then fail 'internal dotenv consumer descriptor is unavailable' "$readonly_exit_preflight"; fi
    printf '%s\n' "$requested_name" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]{0,127}$' || dotenv_refuse name-missing

    repository_root=$(find_repository_root "$repository_path") || dotenv_refuse repository-invalid
    repository_root=$(CDPATH= cd -- "$repository_root" && pwd -P) || dotenv_refuse repository-invalid
    dotenv_path=$repository_root/.intelli-repo/.env
    [ -e "$dotenv_path" ] || dotenv_refuse file-missing
    [ ! -L "$dotenv_path" ] || dotenv_refuse path-unsafe
    [ -f "$dotenv_path" ] || dotenv_refuse file-type-unsafe
    if git -C "$repository_root" ls-files --error-unmatch -- .intelli-repo/.env >/dev/null 2>&1; then
        dotenv_refuse git-exposure
    fi
    git -C "$repository_root" check-ignore -q --no-index -- .intelli-repo/.env || dotenv_refuse git-exposure
    for public_copy in "$repository_root/dist/intelli-repo/.intelli-repo/.env" "$repository_root/src/distribution/.intelli-repo/.env"; do
        [ ! -e "$public_copy" ] && [ ! -L "$public_copy" ] || dotenv_refuse public-tree-exposure
    done

    platform_name=$(uname -s 2>/dev/null || true)
    case "$platform_name" in
        Linux)
            require_command stat
            require_command id
            require_command iconv
            before_record=$(stat -c '%F|%u|%a|%h|%s|%d|%i' -- "$dotenv_path" 2>/dev/null) || dotenv_refuse security-unverifiable
            case "$before_record" in 'regular file|'*) ;; *) dotenv_refuse file-type-unsafe ;; esac
            if ! exec 9<"$dotenv_path"; then dotenv_refuse file-missing; fi
            fd_path=/proc/self/fd/9
            [ -r "$fd_path" ] || dotenv_refuse security-unverifiable
            after_record=$(stat -Lc '%F|%u|%a|%h|%s|%d|%i' -- "$fd_path" 2>/dev/null) || dotenv_refuse security-unverifiable
            [ "$before_record" = "$after_record" ] || dotenv_refuse path-unsafe
            ;;
        Darwin)
            require_command stat
            require_command id
            require_command iconv
            before_record=$(stat -f '%HT|%u|%Lp|%l|%z|%d|%i' "$dotenv_path" 2>/dev/null) || dotenv_refuse security-unverifiable
            case "$before_record" in 'Regular File|'*) ;; *) dotenv_refuse file-type-unsafe ;; esac
            if ! exec 9<"$dotenv_path"; then dotenv_refuse file-missing; fi
            fd_path=/dev/fd/9
            [ -r "$fd_path" ] || dotenv_refuse security-unverifiable
            after_record=$(stat -Lf '%HT|%u|%Lp|%l|%z|%d|%i' "$fd_path" 2>/dev/null) || dotenv_refuse security-unverifiable
            [ "$before_record" = "$after_record" ] || dotenv_refuse path-unsafe
            ;;
        CYGWIN*|MINGW*|MSYS*|Windows_NT)
            dotenv_windows_read "$dotenv_path" "$requested_name"
            return 0
            ;;
        *)
            dotenv_refuse security-unverifiable
            ;;
    esac

    file_owner=$(printf '%s\n' "$after_record" | awk -F '|' '{ print $2 }')
    file_mode=$(printf '%s\n' "$after_record" | awk -F '|' '{ print $3 }')
    file_links=$(printf '%s\n' "$after_record" | awk -F '|' '{ print $4 }')
    file_size=$(printf '%s\n' "$after_record" | awk -F '|' '{ print $5 }')
    [ "$file_owner" = "$(id -u)" ] || dotenv_refuse owner-invalid
    case "$file_mode" in 400|600) ;; *) dotenv_refuse permissions-invalid ;; esac
    [ "$file_links" -eq 1 ] || dotenv_refuse path-unsafe
    [ "$file_size" -le 65536 ] || dotenv_refuse file-too-large

    require_command mkfifo
    dotenv_stream_root=$(mktemp -d "${TMPDIR:-/tmp}/intelli-repo-dotenv-stream.XXXXXX") || dotenv_refuse internal-failure
    chmod 0700 "$dotenv_stream_root" || dotenv_refuse internal-failure
    dotenv_data_fifo=$dotenv_stream_root/data
    dotenv_result_fifo=$dotenv_stream_root/result
    dotenv_status_file=$dotenv_stream_root/status
    mkfifo "$dotenv_data_fifo" "$dotenv_result_fifo" || dotenv_refuse internal-failure
    dotenv_converter_pid=''
    dotenv_parser_pid=''
    dotenv_stream_cleanup() {
        cleanup_result=$?
        trap - EXIT HUP INT TERM
        [ -z "$dotenv_converter_pid" ] || kill "$dotenv_converter_pid" >/dev/null 2>&1 || true
        [ -z "$dotenv_parser_pid" ] || kill "$dotenv_parser_pid" >/dev/null 2>&1 || true
        rm -f -- "$dotenv_data_fifo" "$dotenv_result_fifo" "$dotenv_status_file"
        rmdir -- "$dotenv_stream_root" 2>/dev/null || true
        exit "$cleanup_result"
    }
    trap dotenv_stream_cleanup EXIT HUP INT TERM

    LC_ALL=C awk -v requested="$requested_name" -v status_file="$dotenv_status_file" -v result_fifo="$dotenv_result_fifo" '
        BEGIN { selected = ""; found = 0; error = ""; bom = sprintf("%c%c%c", 239, 187, 191); nul = sprintf("%c", 0) }
        {
            line = $0
            if (NR == 1 && substr(line, 1, 3) == bom) { error = "grammar-invalid"; exit }
            if (substr(line, length(line), 1) == "\r") line = substr(line, 1, length(line) - 1)
            if (index(line, "\r") || index(line, nul)) { error = "grammar-invalid"; exit }
            if (length(line) > 16384) { error = "grammar-invalid"; exit }
            if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
            if (line !~ /^[A-Za-z_][A-Za-z0-9_]*=/) { error = "grammar-invalid"; exit }
            separator = index(line, "=")
            name = substr(line, 1, separator - 1)
            if (length(name) > 128) { error = "grammar-invalid"; exit }
            if (seen[name]++) { error = "duplicate-name"; exit }
            value = substr(line, separator + 1)
            if (value ~ /\$\{/ || value ~ /\$\(/ || value ~ /`/) { error = "grammar-invalid"; exit }
            if (name == requested) { selected = value; found = 1 }
        }
        END {
            if (!error && !found) error = "name-missing"
            if (!error && length(selected) == 0) error = "empty-value"
            if (!error && length(selected) > 8192) error = "value-too-large"
            if (error) {
                print error > status_file
                close(status_file)
                exit
            }
            print "selected" > status_file
            close(status_file)
            printf "%s", selected > result_fifo
            close(result_fifo)
        }
    ' "$dotenv_data_fifo" >/dev/null 2>&1 &
    dotenv_parser_pid=$!
    iconv -f UTF-8 -t UTF-8 <&9 >"$dotenv_data_fifo" 2>/dev/null &
    dotenv_converter_pid=$!
    if ! wait "$dotenv_converter_pid"; then
        dotenv_converter_pid=''
        kill "$dotenv_parser_pid" >/dev/null 2>&1 || true
        wait "$dotenv_parser_pid" 2>/dev/null || true
        dotenv_parser_pid=''
        dotenv_refuse encoding-invalid
    fi
    dotenv_converter_pid=''
    exec 9<&-
    while [ ! -s "$dotenv_status_file" ] && kill -0 "$dotenv_parser_pid" >/dev/null 2>&1; do :; done
    [ -s "$dotenv_status_file" ] || dotenv_refuse internal-failure
    IFS= read -r parser_status <"$dotenv_status_file" || dotenv_refuse internal-failure
    case "$parser_status" in
        selected)
            cat "$dotenv_result_fifo" >&3
            wait "$dotenv_parser_pid" || dotenv_refuse internal-failure
            dotenv_parser_pid=''
            ;;
        grammar-invalid|duplicate-name|name-missing|empty-value|value-too-large)
            wait "$dotenv_parser_pid" || true
            dotenv_parser_pid=''
            dotenv_refuse "$parser_status"
            ;;
        *) dotenv_refuse internal-failure ;;
    esac
    trap - EXIT HUP INT TERM
    rm -f -- "$dotenv_data_fifo" "$dotenv_result_fifo" "$dotenv_status_file"
    rmdir -- "$dotenv_stream_root" || dotenv_refuse internal-failure
}

canonical_requested_path() {
    requested_path=$1
    if [ -d "$requested_path" ]; then
        (CDPATH= cd -- "$requested_path" && pwd -P)
        return
    fi
    requested_parent=${requested_path%/*}
    [ "$requested_parent" = "$requested_path" ] && requested_parent=.
    requested_name=${requested_path##*/}
    [ -n "$requested_name" ] || return 1
    canonical_parent=$(CDPATH= cd -- "$requested_parent" 2>/dev/null && pwd -P) || return 1
    printf '%s/%s\n' "$canonical_parent" "$requested_name"
}

preflight_runtime() {
    require_command git
    require_command curl
    require_command awk
    require_command cat
    require_command chmod
    require_command cmp
    require_command cp
    require_command date
    require_command find
    require_command grep
    require_command head
    require_command mkdir
    require_command sed
    require_command mktemp
    require_command mv
    require_command rm
    require_command rmdir
    require_command tr
    require_command wc
    git_version=$(git --version | awk '{ print $3 }')
    curl_version=$(curl --version | awk 'NR == 1 { print $2 }')
    version_at_least "$git_version" 2.34.0 || fail "Git 2.34 or newer is required; found $git_version" "$readonly_exit_compatibility"
    version_at_least "$curl_version" 7.81.0 || fail "curl 7.81 or newer is required; found $curl_version" "$readonly_exit_compatibility"
    if command -v make >/dev/null 2>&1; then
        make_description=$(make --version 2>/dev/null | awk 'NR == 1 { print; exit }' || true)
        case "$make_description" in
            'GNU Make '*) make_status=$make_description ;;
            *) make_status='present but not GNU Make; convenience targets are not certified' ;;
        esac
    else
        make_status='absent; use the repository-local command directly'
    fi
}

validate_bootstrap_evidence() {
    selected_version=$1
    provenance_file=${INTELLI_REPO_BOOTSTRAP_PROVENANCE:-}
    checksum_file=${INTELLI_REPO_BOOTSTRAP_CHECKSUMS:-}
    bootstrap_version=${INTELLI_REPO_BOOTSTRAP_VERSION:-}
    if [ -n "$provenance_file$checksum_file$bootstrap_version" ]; then
        [ -r "$provenance_file" ] && [ -r "$checksum_file" ] || fail 'bootstrap evidence is incomplete' "$readonly_exit_preflight"
        [ "$bootstrap_version" = "$selected_version" ] || fail 'bootstrap version mismatch' "$readonly_exit_preflight"
        provenance_version=$(yaml_scalar distribution_version "$provenance_file") || fail 'invalid distribution provenance' "$readonly_exit_preflight"
        provenance_base=$(yaml_component base_agent "$provenance_file") || fail 'invalid base-agent provenance' "$readonly_exit_preflight"
        provenance_operator=$(yaml_component operator_agent "$provenance_file") || fail 'invalid operator-agent provenance' "$readonly_exit_preflight"
        provenance_wiki=$(yaml_component wiki_agent "$provenance_file") || fail 'invalid wiki-agent provenance' "$readonly_exit_preflight"
        [ "$provenance_version" = "$readonly_distribution_version" ] || fail 'command and provenance versions differ' "$readonly_exit_preflight"
        [ "$provenance_base" = "$readonly_base_agent_commit" ] || fail 'base-agent pin differs from provenance' "$readonly_exit_preflight"
        [ "$provenance_operator" = "$readonly_operator_agent_commit" ] || fail 'operator-agent pin differs from provenance' "$readonly_exit_preflight"
        [ "$provenance_wiki" = "$readonly_wiki_agent_commit" ] || fail 'wiki-agent pin differs from provenance' "$readonly_exit_preflight"
    fi
}

managed_make_region() {
    cat <<'REGION'
# BEGIN INTELLI-REPO MANAGED v1
.PHONY: intelli-repo-configure intelli-repo-update intelli-repo-doctor intelli-repo-lint intelli-repo-audit intelli-repo-ingest intelli-repo-task intelli-repo-release intelli-repo-uninstall
